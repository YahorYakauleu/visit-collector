# Токен для GET /api/stats — его указывает дашборд (длинная случайная строка)
READ_TOKEN=change-me
# Домены лендингов через запятую; визиты с других доменов отклоняются. Пусто — принимать с любого (только локально)
ALLOWED_ORIGINS=https://example-landing.com
# По какому времени резать сутки — как у Stripe в дашборде
TIMEZONE=America/New_York
# Как часто счётчики из памяти пишутся на диск, секунд
FLUSH_SECONDS=60
# Визитов с одного IP в минуту, сверх — отбрасываются
RATE_LIMIT_PER_MINUTE=60

DATA_DIR=./data
PORT=3000
